{
  "schema_version": 1,
  "experiment_id": "hardcase-scifact-v1",
  "state": "registered_before_probe",
  "seed": 2701,
  "dataset": "beir-scifact",
  "source_url": "https://public.ukp.informatik.tu-darmstadt.de/thakur/BEIR/datasets/scifact.zip",
  "expected": {"documents": 5183, "train_queries": 809, "test_queries": 300, "train_qrels": 919, "test_qrels": 339},
  "student": "sentence-transformers/all-MiniLM-L6-v2",
  "teacher": "cross-encoder/ms-marco-MiniLM-L6-v2",
  "arms": ["uniform_contrastive", "hard_contrastive", "hard_distilled"],
  "model_revisions": "resolve_in_setup_then_freeze_before_training",
  "max_length": 256,
  "document_separator": "\n\n",
  "query_duplicate_trigram_jaccard": 0.9,
  "validation_group_fraction": 0.2,
  "negative_count": 4,
  "mining_top_k": 50,
  "rrf_constant": 60,
  "mining_rank_window": [5, 50],
  "audit_pairs": 40,
  "trainable_blocks": [4, 5],
  "student_temperature": 0.05,
  "teacher_temperature": 1.0,
  "distillation_coefficient": 0.1,
  "optimizer": "AdamW",
  "learning_rate": 0.00002,
  "weight_decay": 0.01,
  "gradient_norm_cap": 1.0,
  "microbatch_queries": 2,
  "accumulation_steps": 4,
  "optimizer_updates": 120,
  "warmup_updates": 12,
  "validation_updates": [40, 80, 120],
  "precision": "float32",
  "hardware_class": "github-standard-public-cpu",
  "max_runner_minutes": 300,
  "selection": {"metric": "ndcg10", "tie_epsilon": 0.000001, "tie_rule": "earliest_update_then_arm_order"},
  "metrics": ["ndcg10", "recall10", "recall100", "mrr10"],
  "bootstrap_resamples": 10000,
  "bootstrap_unit": "connected_query_group",
  "secondary_sign_flips": 10000,
  "secondary_correction": "benjamini_hochberg",
  "export": {"opset": 18, "max_abs_error": 0.0001, "max_cosine_distance": 0.00001, "dynamic_int8": true},
  "promotion": {"validation_gain_min": 0.01, "test_gain_min": 0.0, "interval_lower_exclusive": -0.01, "recall100_change_min": -0.02, "warm_p95_ms_max": 1500, "peak_rss_mib_max": 768},
  "limits": {"body_bytes": 8192, "query_characters": 512, "top_k_max": 20, "deadline_seconds": 10, "session_active_searches": 1},
  "resource_revision": "Only before all arms; retain one complete fit pass; rebuild all affected views and baselines",
  "final_evaluation": "Requires immutable selection and bundle freeze; no test-driven rescue"
}
